# Copie para .env e preencha os valores. O arquivo .env nao vai para o Git.

# Banco de dados PostgreSQL (Neon)
DB_URL=jdbc:postgresql://SEU_HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# Cache: simple (memoria, padrao) ou redis
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379

# Amazon S3 / Neon Object Storage (avatares de perfil)
# A API usa a cadeia padrao de credenciais da AWS; as variaveis abaixo sao opcionais
# se voce usar ~/.aws/credentials ou uma IAM Role.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional para credenciais temporarias (STS)
AWS_SESSION_TOKEN=
# Endpoint S3 compativel (Neon Object Storage, MinIO, LocalStack...)
AWS_ENDPOINT_URL_S3=
S3_BUCKET=perfis
# Opcional: CDN/dominio publico do bucket. Deixe vazio para a URL padrao do S3.
S3_PUBLIC_BASE_URL=
S3_MAX_BYTES=5242880
